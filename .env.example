# Copy to .env.local and fill in values from your Supabase demo project
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Tenant-isolation tests authenticate as demo users through the anon client.
# Set TEST_DEMO_PASSWORD only in a private local/CI environment; it is never
# embedded in the application bundle or published in this repository.
TEST_DEMO_PASSWORD=
# Do not add a service_role key: it bypasses the RLS policies under test.

# That is the COMPLETE web-tier environment — deliberately. Stripe, Xero and
# Twilio secrets live only in Edge Function secrets (supabase secrets set …);
# the n8n webhook URL and the Xero token-encryption key live in Supabase
# Vault. The deployed web app cannot touch a privileged credential even in
# principle. See docs/SETUP.md for the full secret inventory.
